<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.bikerentandroid.LoginFragment"
        android:label="Login">

        <action
            android:id="@+id/action_loginFragment_to_mapFragment"
            app:destination="@id/mapFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.bikerentandroid.RegisterFragment"
        android:label="Register">

        <action
            android:id="@+id/action_registerFragment_to_mapFragment"
            app:destination="@id/mapFragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.example.bikerentandroid.MapFragment"
        android:label="Map" />

    <fragment
        android:id="@+id/scanFragment"
        android:name="com.example.bikerentandroid.ScanFragment"
        android:label="Scan">

        <action
            android:id="@+id/action_scanFragment_to_bikeInfoFragment"
            app:destination="@id/bikeInfoFragment"
            app:popUpTo="@id/scanFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/bikeInfoFragment"
        android:name="com.example.bikerentandroid.BikeInfoFragment"
        android:label="Bike info">

        <argument
            android:name="bikeId"
            app:argType="string" />
        <action
            android:id="@+id/action_bikeInfoFragment_to_rideFragment"
            app:destination="@id/rideFragment"
            app:popUpTo="@id/rideFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/rideFragment"
        android:name="com.example.bikerentandroid.RideFragment"
        android:label="Ride">

        <argument
            android:name="startTimeMillis"
            app:argType="long" />
        <argument
            android:name="pricePerHour"
            app:argType="float" />
    </fragment>

    <fragment
        android:id="@+id/cameraFragment"
        android:name="com.example.bikerentandroid.CameraFragment"
        android:label="Camera" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.bikerentandroid.SettingsFragment"
        android:label="Settings" >

        <action
            android:id="@+id/action_logout"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>


    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.example.bikerentandroid.EditProfileFragment"
        android:label="Edit Profile" />

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.example.bikerentandroid.HistoryFragment"
        android:label="History" />
    <fragment
        android:id="@+id/changePasswordFragment"
        android:name="com.example.bikerentandroid.ChangePasswordFragment"
        android:label="Change password" />


</navigation>
